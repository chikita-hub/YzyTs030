                    <GradientStopCollection>
                        <GradientStop Color="#00B2FFD8"
                    Offset="0" />
                        <GradientStop Color="#60B2FFD8"
                    Offset="0.4" />
                        <GradientStop Color="#60B2FFD8"
                    Offset="0.6" />
                        <GradientStop Color="#00B2FFD8"
                    Offset="1" />
