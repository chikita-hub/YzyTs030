<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:propla"
                    >


            <Color x:Key="ColorMain">#FFD6FFEA</Color>

            <!--Control colors.-->
            <Color x:Key="WindowColor">#FFD6FFEA</Color>
            <Color x:Key="ContentAreaColorLight">#FFDBFFED</Color>
            <Color x:Key="ContentAreaColorDark">#FFD6FFEA</Color>

            <Color x:Key="DisabledControlLightColor">#FFEAFFF4</Color> 
            <Color x:Key="DisabledControlDarkColor">#FFDBFFED</Color>
            <Color x:Key="DisabledForegroundColor">#FFF4FFF9</Color>

            <Color x:Key="SelectedBackgroundColor">#FFDBFFED</Color>
            <Color x:Key="SelectedUnfocusedColor">#FFE5FFF2</Color>

            <Color x:Key="ControlLightColor">White</Color>
            <Color x:Key="ControlMediumColor">#FFD6FFEA</Color>
            <Color x:Key="ControlDarkColor">#FFB7FFDB</Color>

            <Color x:Key="ControlMouseOverColor">#FFBCFFDD</Color>
            <Color x:Key="ControlPressedColor">#FFB7FFDB</Color>


            <Color x:Key="GlyphColor">#FFF9FFFC</Color>
            <Color x:Key="GlyphMouseOver">sc#1, 0.004391443, 0.002428215, 0.242281124</Color>

            <!--Border colors-->
