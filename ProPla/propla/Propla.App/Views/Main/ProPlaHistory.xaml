<Window x:Class="Propla.ProPlaHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Propla"
        mc:Ignorable="d"
        Title="更新履歴" 
        Height="700" Width="1330"  Top="0" Left="0"
        >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </Window.Resources>

    <Grid  x:Name="MainGrid"  Height="700" Width="1330" Background= "#ffffff">
        <Grid.RowDefinitions>
            <RowDefinition Height="153*"/>
            <RowDefinition Height="547*"/>
        </Grid.RowDefinitions>




        <StackPanel Name="MainPanel"  Background= "#ffffff"   VerticalAlignment="Top" Grid.RowSpan="2">



            <StackPanel Name="RowPanel1" Orientation="Horizontal" >
                <Button Content="戻る"     Name="BtnEnd" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
                <TextBlock Text="" Name="TextMsg" Foreground="Black"  FontSize="16" Width="600"
                           Background="Transparent"
                           Margin="300,0,0,0"
                />
                <Button Content="－"     Name="BtnWindowStateMinimized" HorizontalAlignment="Left" Height="20" Width="20"  Margin="170,5,0,5"   Click="OnBtnClick"/>


            </StackPanel>
            <Border Name="BorderOut" Margin="10,5,40,5" BorderBrush="#FF688CAF" BorderThickness="1,1,1,1" >
                <StackPanel Name="RowPanelOut" Orientation="Horizontal" >
                    <Button Content="全選択" Name="BtnAllSel" HorizontalAlignment="Left" Height="30" Width="80"  Margin="100,5,0,5"   Click="OnBtnClick"/>
                    <Button Content="全解除" Name="BtnAllLift" HorizontalAlignment="Left" Height="30" Width="80"  Margin="50,5,0,5"   Click="OnBtnClick"/>
                </StackPanel>
            </Border>

            <StackPanel Name="StackPanelHistory" Orientation="Horizontal" >
                <TextBlock Text="" Name="TextInformation" HorizontalAlignment="Center" VerticalAlignment="Center"  Height="30"
                                    />
            </StackPanel>

            <StackPanel  Orientation="Horizontal"  >

                <DataGrid ItemsSource="{Binding Items, Mode=OneWay}"   
                    Style="{DynamicResource DataGridStyle1}"
                    IsReadOnly="True" 
                    VerticalAlignment="Top"
                    Height="500" Width="1280"
                    AutoGenerateColumns="False"
                    Name="DataGridMain" Margin="10,10,10,10" Grid.RowSpan="3" 
                    MouseDoubleClick="DataGridMainMouseDoubleClick"
                    >
                    <DataGrid.Columns >
                        <DataGridTextColumn Header="項目キー" Binding="{Binding colkey }" Width="0"  x:Name="DataGridcolkey" />
                        <DataGridTextColumn Header="項目名"   Binding="{Binding colname}" Width="300"  x:Name="DataGridcolname" />
                        <DataGridTextColumn Header="更新前の値"   Binding="{Binding befor}" Width="450"  x:Name="DataGridbefor" />
                        <DataGridTextColumn Header="更新後の値"   Binding="{Binding after}" Width="450"  x:Name="DataGridafter" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
