<Page x:Class="Propla.ProPlaMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Propla"
        mc:Ignorable="d"  
        ShowsNavigationUI="False"
        Title="ProPlaMain"  Height="700" Width="1330"  >

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="MainGrid"  Margin="0" Background="#ffffff">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="100" />
            <RowDefinition Height="500" />
        </Grid.RowDefinitions>
        <StackPanel Height="30" Name="ButtonPanel" Width="Auto"  Orientation="Horizontal" Background="#ffffff" >
            <Button x:Name="BtnUpdPer" Content="更新許可"      Grid.Row="0" Click="OnBtnClick" Width="100"  Margin="100,0,0,0"  />
            <Button x:Name="BtnUpdate" Content="更新"          Grid.Row="0" Click="OnBtnClick" Width="100"  Margin="100,0,0,0"  />
            <Button x:Name="BtnReg"    Content="引用"          Grid.Row="0" Click="OnBtnClick" Width="100"  Margin="100,0,0,0"  />
            <Button x:Name="BtnEnd"    Content="戻る"          Grid.Row="0" Click="OnBtnClick" Width="100"  Margin="100,0,0,0"  />
            <Button Content="－"     Name="BtnWindowStateMinimized" HorizontalAlignment="Left" Height="20" Width="20"  Margin="400,5,0,5"   Click="OnBtnClick"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Height="100" Width="Auto"  Orientation="Horizontal" Background="#ffffff" Margin="20,0,20,4">
            <Border  CornerRadius="4" Background="#FFD6FFEA"   Width="620"  HorizontalAlignment="Left" >
                <Label  Width="600" Height="80" Background="Transparent"  >
                    <Label.Content>
                        <TextBlock Name="LabelProductName" TextWrapping="Wrap" FontSize="26">
            これは初期のテキストです。
                        </TextBlock>
                    </Label.Content>
                </Label>
            </Border>
            <StackPanel  Orientation="Horizontal"    Height="Auto"  Margin="0,5,0,0"  Background="#FFD6FFEA">
                <StackPanel Orientation="Horizontal"    Height="80"  Margin="0"  Background="#FFD6FFEA">
                    <TextBox    Name="PopUpLink"  Width="0" Height="0"  
                                           Text="{Binding Item.PopUpLink,Mode=TwoWay}"   
                                           TextChanged="TextBoxTextChanged" 
                                           VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"
                                />
                    <Wpf:WebView2   Source="http://example.com/"  Name="WebPopUpLink" Width="600" Height="80" Margin="4,0,0,0"
                                                   CoreWebView2InitializationCompleted="WebView2InitializationCompleted" ToolTip="ﾎﾟｯﾌﾟｱｯﾌﾟﾘﾝｸ"
                                    />
                    <Button x:Name="BtnHtml_PopUpLink" Content="編集" HorizontalAlignment="Right"  Click="OnBtnClick" 
                                            Width="40" Height="80" Margin="0,0,0,0"  
                                    />

                </StackPanel>
            </StackPanel>

        </StackPanel>

        <ScrollViewer Grid.Row="2"  Name="MainScrollViewer" 
                      Height="500" Width="1270"  VerticalScrollBarVisibility="Auto" CanContentScroll="False" VerticalAlignment="Top" Margin="20,0,20,0">
            <StackPanel Name="MainPanel" Height="Auto" Width="1280" Background="#ffffff"   VerticalAlignment="Top">
                <Border Name="Border_LSP_Label001" CornerRadius="4" Background="#8ec6ff"   Width="1247"  HorizontalAlignment="Left" >
                    <Label Content="商品区分" Name="Label001"  Background="Transparent"   />
                </Border>
                <StackPanel Name="LSP_Label001" Height="Auto" Width="Auto"  Margin="0,0,0,0"  Background="White">
                    <Border Padding="0,5,0,5" Background="White">
                    <StackPanel  Background="White">
                        <StackPanel Name="RSP_Label001_001" Orientation="Horizontal"    Height="Auto"  Margin="0,0,0,0"  Background="White">
                            <StackPanel Name="CSP_Label001_001_001_ProductPlanningID" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="商品ID" Name="TextBlockProductPlanningID" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductPlanningID"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductPlanningID,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="商品ID"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="1000"
                                   GotFocus="TextBoxGotFocusAlphanumeric"
                                 />
                            </StackPanel>
                            <StackPanel Name="CSP_Label001_001_002_ProductCategory" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="商品区分" Name="TextBlockProductCategory" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <Border Style="{StaticResource MyBorder1}" 
                                        Name="BorderComboBoxProductCategory"
                                        Width="275" Height="40" Margin="4,0,0,0" >
                                    <ComboBox Name="ProductCategory"      Style="{DynamicResource ComboBoxStyle1}" 
                                        SelectedValue="{Binding Item.ProductCategory,Mode=TwoWay}" 
                                        ItemsSource = "{Binding ItemMst.MstProductCategoryDt.DefaultView}" 
                                        DisplayMemberPath = "name"
                                        SelectedValuePath = "value" SelectionChanged="ComboBoxChanged" ToolTip="商品区分"  TabIndex="1"
                                    />    
                                </Border>
                            </StackPanel>
                            <StackPanel Name="CSP_Label001_001_003_ProductPerson" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="商品担当者" Name="TextBlockProductPerson" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductPerson"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductPerson,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="商品担当者"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="2"
                                   GotFocus="TextBoxGotFocusNative"
                                 />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                <Border Name="Border_LSP_Label002" CornerRadius="4" Background="#8ec6ff"   Width="1247"  HorizontalAlignment="Left" >
                    <Label Content="商品名" Name="Label002"  Background="Transparent"   />
                </Border>
                <StackPanel Name="LSP_Label002" Height="Auto" Width="Auto"  Margin="0,0,0,0"  Background="White">
                    <Border Padding="0,5,0,5" Background="White">
                    <StackPanel  Background="White">
                        <StackPanel Name="RSP_Label002_001" Orientation="Horizontal"    Height="Auto"  Margin="0,0,0,0"  Background="White">
                            <StackPanel Name="CSP_Label002_001_001_ProductNameOfficial" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="正式商品名" Name="TextBlockProductNameOfficial" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductNameOfficial"  Width="694" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductNameOfficial,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="正式商品名"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="3"
                                   GotFocus="TextBoxGotFocusNative"
                                 />
                            </StackPanel>
                            <StackPanel Name="CSP_Label002_001_002_ProductNameRuby" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="読み仮名" Name="TextBlockProductNameRuby" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductNameRuby"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductNameRuby,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="読み仮名"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="4"
                                   GotFocus="TextBoxGotFocusNative"
                                 />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Name="RSP_Label002_002" Orientation="Horizontal"    Height="Auto"  Margin="0,5,0,0"  Background="White">
                            <StackPanel Name="CSP_Label002_002_001_ProductNameOfficialE" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="正式商品名&#10;（英表記）" Name="TextBlockProductNameOfficialE" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductNameOfficialE"  Width="694" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductNameOfficialE,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="正式商品名&#10;（英表記）"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="5"
                                   GotFocus="TextBoxGotFocusAlphanumeric"
                                 />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Name="RSP_Label002_003" Orientation="Horizontal"    Height="Auto"  Margin="0,5,0,0"  Background="White">
                            <StackPanel Name="CSP_Label002_003_001_ProductNameOmit1" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="略称" Name="TextBlockProductNameOmit1" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductNameOmit1"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductNameOmit1,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="略称"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="6"
                                   GotFocus="TextBoxGotFocusNative"
                                 />
                            </StackPanel>
                            <StackPanel Name="CSP_Label002_003_002_ProductNameReceipt" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="お買上票の商品名" Name="TextBlockProductNameReceipt" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductNameReceipt"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductNameReceipt,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="お買上票の商品名"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="7"
                                   GotFocus="TextBoxGotFocusNative"
                                 />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                <Border Name="Border_LSP_Label003" CornerRadius="4" Background="#8ec6ff"   Width="1247"  HorizontalAlignment="Left" >
                    <Label Content="発売履歴" Name="Label003"  Background="Transparent"   />
                </Border>
                <StackPanel Name="LSP_Label003" Height="Auto" Width="Auto"  Margin="0,0,0,0"  Background="White">
                    <Border Padding="0,5,0,5" Background="White">
                    <StackPanel  Background="White">
                        <StackPanel Name="RSP_Label003_001" Orientation="Horizontal"    Height="Auto"  Margin="0,0,0,0"  Background="White">
                            <StackPanel Name="CSP_Label003_001_001_ProductReleaseStatus" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="発売の状態" Name="TextBlockProductReleaseStatus" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <Border Style="{StaticResource MyBorder1}" 
                                        Name="BorderComboBoxProductReleaseStatus"
                                        Width="275" Height="40" Margin="4,0,0,0" >
                                    <ComboBox Name="ProductReleaseStatus"      Style="{DynamicResource ComboBoxStyle1}" 
                                        SelectedValue="{Binding Item.ProductReleaseStatus,Mode=TwoWay}" 
                                        ItemsSource = "{Binding ItemMst.MstProductReleaseStatusDt.DefaultView}" 
                                        DisplayMemberPath = "name"
                                        SelectedValuePath = "value" SelectionChanged="ComboBoxChanged" ToolTip="発売の状態"  TabIndex="8"
                                    />    
                                </Border>
                            </StackPanel>
                            <StackPanel Name="CSP_Label003_001_002_ProductTestReleaseDate" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="テスト発売日" Name="TextBlockProductTestReleaseDate" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductTestReleaseDate"  Width="235" Height="40" Margin="4,0,0,0" 
                                           Text="{Binding Item.ProductTestReleaseDate,Mode=TwoWay}"   
                                           TextChanged="TextBoxTextChanged" ToolTip="テスト発売日"
                                           VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="9"
                                />
                                <Button x:Name="BtnCal_ProductTestReleaseDate" Grid.Column="1" Content="Cal" HorizontalAlignment="Right"  Click="OnBtnClick" 
                                        Width="40" Height="40" Margin="0,0,0,0"   TabIndex="9"
                                />
                            </StackPanel>
                            <StackPanel Name="CSP_Label003_001_003_ProductReleaseDate" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="本発売日" Name="TextBlockProductReleaseDate" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductReleaseDate"  Width="235" Height="40" Margin="4,0,0,0" 
                                           Text="{Binding Item.ProductReleaseDate,Mode=TwoWay}"   
                                           TextChanged="TextBoxTextChanged" ToolTip="本発売日"
                                           VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="10"
                                />
                                <Button x:Name="BtnCal_ProductReleaseDate" Grid.Column="1" Content="Cal" HorizontalAlignment="Right"  Click="OnBtnClick" 
                                        Width="40" Height="40" Margin="0,0,0,0"   TabIndex="10"
                                />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Name="RSP_Label003_002" Orientation="Horizontal"    Height="Auto"  Margin="0,5,0,0"  Background="White">
                            <StackPanel Name="CSP_Label003_002_001_ProductAnniversary" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="本発売日からの&#10;周年" Name="TextBlockProductAnniversary" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductAnniversary"  Width="275" Height="40" Margin="4,0,0,0"
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="2000"
                                 />
                            </StackPanel>
                            <StackPanel Name="CSP_Label003_002_002_ProductRenewalHistory" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="リニューアル履歴" Name="TextBlockProductRenewalHistory" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductRenewalHistory"  Width="235" Height="40" Margin="4,0,0,0" 
                                           Text="{Binding Item.ProductRenewalHistory,Mode=TwoWay}"   
                                           TextChanged="TextBoxTextChanged" ToolTip="リニューアル履歴"
                                           VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="12"
                                />
                                <Button x:Name="BtnPop_ProductRenewalHistory" Grid.Column="1" Content="表示" HorizontalAlignment="Right"  Click="OnBtnClick" 
                                        Width="40" Height="40" Margin="0,0,0,0"   TabIndex="12"
                                />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                <Border Name="Border_LSP_Label004" CornerRadius="4" Background="#8ec6ff"   Width="1247"  HorizontalAlignment="Left" >
                    <Label Content="商標" Name="Label004"  Background="Transparent"   />
                </Border>
                <StackPanel Name="LSP_Label004" Height="Auto" Width="Auto"  Margin="0,0,0,0"  Background="White">
                    <Border Padding="0,5,0,5" Background="White">
                    <StackPanel  Background="White">
                        <StackPanel Name="RSP_Label004_001" Orientation="Horizontal"    Height="Auto"  Margin="0,0,0,0"  Background="White">
                            <StackPanel Name="CSP_Label004_001_001_TrademarkAcquisitionList" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="商標取得一覧" Name="TextBlockTrademarkAcquisitionList" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                               <TextBox    Name="TrademarkAcquisitionList"  Width="0" Height="0"  
                                           Text="{Binding Item.TrademarkAcquisitionList,Mode=TwoWay}"   
                                           TextChanged="TextBoxTextChanged" 
                                           VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"
                                />
                                <Border Style="{StaticResource MyBorder1}" BorderThickness="2"  BorderBrush="#C5D8FF"       >
                                   <Wpf:WebView2   Source="http://example.com/"  Name="WebTrademarkAcquisitionList" Width="231" Height="40" Margin="4,0,0,0"
                                                   CoreWebView2InitializationCompleted="WebView2InitializationCompleted" ToolTip="商標取得一覧"
                                    />
                                </Border>
                                <Border Style="{StaticResource MyBorder1}" 
                                            Name="BorderButtonTrademarkAcquisitionList"  
                                            >
                                   <Button x:Name="BtnHtml_TrademarkAcquisitionList" Content="編集" HorizontalAlignment="Right"  Click="OnBtnClick" 
                                            Width="40" Height="40" Margin="0,0,0,0"  TabIndex="14"
                                    />
                               </Border>

                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </StackPanel>
                <Border Name="Border_LSP_Label005" CornerRadius="4" Background="#8ec6ff"   Width="1247"  HorizontalAlignment="Left" >
                    <Label Content="商品情報" Name="Label005"  Background="Transparent"   />
                </Border>
                <StackPanel Name="LSP_Label005" Height="Auto" Width="Auto"  Margin="0,0,0,0"  Background="White">
                    <Border Padding="0,5,0,5" Background="White">
                    <StackPanel  Background="White">
                        <StackPanel Name="RSP_Label005_001" Orientation="Horizontal"    Height="Auto"  Margin="0,0,0,0"  Background="White">
                            <StackPanel Name="CSP_Label005_001_001_ProductWeight" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="内容量" Name="TextBlockProductWeight" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductWeight"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductWeight,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="内容量"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="15"
                                   GotFocus="TextBoxGotFocusNative"
                                 />
                            </StackPanel>
                            <StackPanel Name="CSP_Label005_001_002_ProductForm" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="商品形状" Name="TextBlockProductForm" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="ProductForm"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.ProductForm,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="商品形状"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="16"
                                   GotFocus="TextBoxGotFocusNative"
                                 />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Name="RSP_Label005_002" Orientation="Horizontal"    Height="Auto"  Margin="0,5,0,0"  Background="White">
                            <StackPanel Name="CSP_Label005_002_001_JANCode" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="0,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="JANコード&#10;【外装／個包装】" Name="TextBlockJANCode" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                    />
                                </Border>
                                <TextBox   Name="JANCode"  Width="275" Height="40" Margin="4,0,0,0"
                                   Text="{Binding Item.JANCode,Mode=TwoWay}"   
                                   TextChanged="TextBoxTextChanged"  ToolTip="JANコード&#10;【外装／個包装】"
                                   KeyDown="TextBoxKeyDown"        
                                   VerticalScrollBarVisibility="Auto" TextBoxBase.AcceptsReturn="True" TextWrapping="Wrap"  TabIndex="17"
                                   GotFocus="TextBoxGotFocusAlphanumeric"
                                 />
                            </StackPanel>
                            <StackPanel Name="CSP_Label005_002_002_StockID" Orientation="Horizontal"    Height="Auto"  Margin="0"  Background="White">
                                <Border Style="{StaticResource MyBorder1}" Width="130" Height="Auto" Margin="10,0,0,0"  Background="#C5D8FF"  >
                                    <TextBlock Text="在庫ID" Name="TextBlockStockID" Foreground="Black"  FontSize="16"
                                               Background="Transparent"  HorizontalAlignment="Center" VerticalAlignment="Center"
