<Page x:Class="Propla.ProPlaSearch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Propla"
      mc:Ignorable="d" 
      ShowsNavigationUI="False"
     Height="700" Width="1330"
    Title="ProPlaSearch">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>


    <Grid  x:Name="MainGrid"  Height="700" Width="1330" Background= "#ffffff">
        <Grid.RowDefinitions>
            <RowDefinition Height="153*"/>
            <RowDefinition Height="547*"/>
        </Grid.RowDefinitions>




        <StackPanel Name="MainPanel"  Background= "#ffffff"   VerticalAlignment="Top" Grid.RowSpan="2">

            <StackPanel Name="StackPanelHistory" Orientation="Horizontal"    Height="Auto"  Margin="10" Background="Orange">
                <Border Style="{StaticResource MyBorder1}" Width="130"  Margin="600,0,0,0" Background="Orange"
                         HorizontalAlignment="Center" VerticalAlignment="Center"

                        >
                    <TextBlock Text="更新履歴"  HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Background="Transparent"
                                    />
                </Border>
            </StackPanel>


            <StackPanel Name="RowPanel1" Orientation="Horizontal" >
                <Button Content="新規登録" Name="BtnNew" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
                <Button Content="戻る"     Name="BtnEnd" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
                <!--<Button Content="出力画面" Name="BtnOutSw" HorizontalAlignment="Left" Height="30" Width="100"  Margin="400,5,0,5"   Click="OnBtnClick"--> 
                        <!--Style="{StaticResource ButtonStyle4}" Foreground="White"                        />-->
                <Button Content="－"     Name="BtnWindowStateMinimized" HorizontalAlignment="Left" Height="20" Width="20"  Margin="860,5,0,5"   Click="OnBtnClick"/>
            </StackPanel>
            
            <Border Name="BorderOut" Margin="10,5,40,5" BorderBrush="#FF688CAF" BorderThickness="1,1,1,1" >
                <StackPanel>

                    <StackPanel>
                        <TextBlock Name="TextBlockOut" Text="※選択した項目を保存する場合は「選択保存」を押し、次回は選択読込を押してご利用ください。"
                                   FontSize="14"
                         Margin="680,0,0,0"    />
                    </StackPanel>


                    <StackPanel Name="RowPanelOut" Orientation="Horizontal" >
                        <Button Content="全選択" Name="BtnAllSel" HorizontalAlignment="Left" Height="30" Width="80"  Margin="100,5,0,5"   Click="OnBtnClick"/>
                        <Button Content="全解除" Name="BtnAllLift" HorizontalAlignment="Left" Height="30" Width="80"  Margin="50,5,0,5"   Click="OnBtnClick"/>
                        <Border Style="{StaticResource MyBorder1}" Width="70"  Margin="100,0,0,0"   >
                            <TextBlock Text="出力種別"   
                                                   Background="Transparent"  HorizontalAlignment="Left" VerticalAlignment="Center"
                                        />
                        </Border>
                        <ComboBox Name="MainCmbOutTemplate"      Style="{DynamicResource ComboBoxStyle1}" 
                                                ItemsSource = "{Binding ItemMst.MstOutTemplateDt.DefaultView}" 
                                                DisplayMemberPath = "name"
                                                SelectedValuePath = "value" SelectionChanged="ComboBoxChanged" 
                                Margin="10,5,0,5"    Width="200" 
                                            />
                        <Button Content="項目選択" Name="BtnColSelect" HorizontalAlignment="Left" Height="30" Width="80"  Margin="20,5,0,5"   Click="OnBtnClick"/>
                        <Button Content="選択保存" Name="BtnSelKeep" HorizontalAlignment="Left" Height="30" Width="80"  Margin="50,5,0,5"   Click="OnBtnClick"/>
                        <Button Content="選択読込" Name="BtnSelload" HorizontalAlignment="Left" Height="30" Width="80"  Margin="50,5,0,5"   Click="OnBtnClick"/>
                        <Button Content="出力" Name="BtnOut" HorizontalAlignment="Left" Height="30" Width="80"  Margin="100,5,0,5"   Click="OnBtnClick"
                                Style="{StaticResource ButtonStyle4}" Foreground="White"    />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Name="BorderKey" Margin="10,5,40,5" BorderBrush="#FF688CAF" BorderThickness="1,1,1,1" >
                <StackPanel Name="RowPanel2" Orientation="Horizontal"   >
                    <Border Style="{StaticResource MyBorder1}" Width="100"  Margin="0,0,0,0"   >
                        <TextBlock Text="キーワード"   
                                               Background="Transparent"  HorizontalAlignment="Left" VerticalAlignment="Center"
                                    />
                    </Border>
                    <TextBox   Name="TxtSerch"   Height="30" Width="200"  Margin="0,0,0,0" 
                               KeyDown="OnKeyDownHandler"
                               GotFocus="TextBoxGotFocusNative"
                               />
                    <Border Style="{StaticResource MyBorder1}" Width="50"  Margin="40,0,0,0"   >
                        <TextBlock Text="状態"   
                                               Background="Transparent"  HorizontalAlignment="Left" VerticalAlignment="Center"
                                    />
                    </Border>
                    <ComboBox Name="MainCmbProductReleaseStatus"      Style="{DynamicResource ComboBoxStyle1}" 
                                            ItemsSource = "{Binding ItemMst.MstProductReleaseStatusDt.DefaultView}" 
                                            DisplayMemberPath = "name"
                                            SelectedValuePath = "value" SelectionChanged="ComboBoxChanged" ToolTip="発売の状態"
                            Margin="0,5,0,5"    Width="200" 
                                        />
                    <Button Content="検索"     Name="BtnSer" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"
                                Style="{StaticResource ButtonStyle5}" Foreground="White"    />
                </StackPanel>
            </Border>

            <StackPanel  Orientation="Horizontal"  >

                <DataGrid ItemsSource="{Binding Items, Mode=OneWay}"   
                    Style="{DynamicResource DataGridStyle1}"
                    IsReadOnly="True" 
                    VerticalAlignment="Top"
                    Height="426" Width="1280"
                    AutoGenerateColumns="False"
                    Name="DataGridMain" Margin="10,10,10,10" Grid.RowSpan="3" 
                    MouseDoubleClick="DataGridMainMouseDoubleClick"
                    >

                    <DataGrid.Columns >
                        <DataGridTemplateColumn  Header=""  Width="80"  x:Name="BtnSelect">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Name="BtnDgSelect" Content="選択" Click="OnBtnClick" Tag="{Binding}" IsEnabled="{Binding Actionable}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="更新日" Binding="{Binding updatedate}" Width="170"  x:Name="DataGridupdatedate" />
                        <DataGridTextColumn Header="更新者" Binding="{Binding updateuser}" Width="100"  x:Name="DataGridupdateuser" />

                        <DataGridTextColumn Header="商品ID" Binding="{Binding ProductPlanningID}" Width="100"   />

                        <DataGridComboBoxColumn  Header="商品区分"  x:Name="CmbProductCategory"
                                             SelectedValueBinding="{Binding ProductCategory}" 
                                             DisplayMemberPath = "name"
                                             SelectedValuePath = "value"
                                             Width="250" />

                        <DataGridComboBoxColumn  Header="状態"      x:Name="CmbProductReleaseStatus"
                                             SelectedValueBinding="{Binding ProductReleaseStatus}" 
                                             DisplayMemberPath = "name"
                                             SelectedValuePath = "value"
                                             Width="120" />

                        <DataGridTextColumn Header="正式商品名" Binding="{Binding ProductNameOfficial}" Width="600"   />

                        <DataGridTemplateColumn  Header="" Width="80" x:Name="DataGridHistory">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Name="BtnHistory" Content="更新履歴" Click="OnBtnClick" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>

        </StackPanel>
    </Grid>

</Page>
