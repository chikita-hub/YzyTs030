            <StackPanel Height="60"  Width="Auto"   Orientation="Horizontal"  >
                <TextBlock Text="商品情報マスタ"  Margin="500,0,0,0"
                           FontSize="40" HorizontalAlignment="Center" 
                           VerticalAlignment="Center"  FontWeight="Heavy" 
                           Foreground="#00339A" 
                />
                <Button Content="－"  VerticalAlignment="Top" HorizontalAlignment="Left" Height="20" Width="20"  Margin="420,0,0,0"   Click="OnBtnClick"/>
            </StackPanel>

            <StackPanel Height="95"  Width="Auto"  Orientation="Horizontal" >
                <Button x:Name="Btn1" Content=""      Grid.Row="0" Click="OnBtnClick" Width="500"  Height="50" Margin="100,0,0,0"  Visibility="Hidden" />
