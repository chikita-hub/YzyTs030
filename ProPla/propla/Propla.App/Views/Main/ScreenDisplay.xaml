<Page x:Class="Propla.ScreenDisplay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Propla"
      mc:Ignorable="d" 
     Height="700" Width="1330"
      Title="ScreenDisplay">
 
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Height="700" Width="1330" >
        <StackPanel Name="MainPanel"    VerticalAlignment="Top">

            <StackPanel Name="RowPanel1" Orientation="Horizontal" >
                <Button Content="戻る"     Name="BtnEnd"  Height="30" Width="100"  Margin="600,5,0,5"   Click="OnBtnClick"/>
                <CheckBox x:Name="ChkUpdating"
                          Content="更新中のみ表示"
                          Checked="ChkUpdatingChecked"
                          Unchecked="ChkUpdatingUnchecked" Height="30" Width="100"  Margin="200,5,0,5" />
                <Button Content="ロック解除"     Name="BtnLockRelease"  Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"  Name="MainScrollViewer" 
                      Height="610" Width="1250"  VerticalScrollBarVisibility="Auto" CanContentScroll="False" VerticalAlignment="Top">

                <StackPanel  Orientation="Horizontal" Margin="10" >
                    <DataGrid Name="DataGridScreenDisplay" Style="{DynamicResource DataGridStyle1}" ItemsSource="{Binding}"
                              Margin="10" SelectionMode="Single"
                              >
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

    </Grid>
</Page>
