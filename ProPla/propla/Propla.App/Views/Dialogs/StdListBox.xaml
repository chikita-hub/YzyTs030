<Window x:Class="Propla.StdListBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Propla"
        mc:Ignorable="d"
        Title="Window1" Height="700" Width="1330" Top="0" Left="0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FFD9D9D9"/>
            <ControlTemplate x:Key="ListBoxTemplate1" TargetType="{x:Type ListBox}">

                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="true">
                    <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Background}"/>
                        <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Border}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsGrouping" Value="true"/>
                            <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </Window.Resources>


    <Grid  x:Name="MainGrid" Margin="10">
        <StackPanel Height="Auto" Name="MainPanel" Width="Auto"   >

            <StackPanel  Height="Auto" Width="Auto"  Margin="0,0,0,0" Background="White" Orientation="Horizontal">
                <Button Name="register" 
					            Click="OnBtnClick" FontWeight="Bold"
					            Width="100" Content="登録" Grid.Column="0"  Margin="100,2,0,2" Height="26"/>
                <Button Name="cancel" 
					            Click="OnBtnClick" FontWeight="Bold"
					            Width="100" Content="キャンセル"  Margin="500,2,0,2" Height="26"/>
            </StackPanel>

            <StackPanel Name="StackPanel1" Height="Auto" Width="Auto"  Margin="0,10,0,0">

                <TextBlock  Name="TextBlock1" Text="原材料" Margin="2"  HorizontalAlignment="Center" VerticalAlignment="Center"
                           Background="Transparent" FontWeight="Bold" 
                 />

                <Grid Name="Grid1"  Height="240" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="listBoxIn1" Margin="0,0,0,10"
		                Grid.Column="0"
			                SelectionMode="Extended"
                             MouseDoubleClick="ListBoxMouseDoubleClick"
		                >
                        <ListBox.ItemContainerStyle >
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FontFamily" Value="BIZ UDPゴシック" />
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>



                    <ListBox Template="{DynamicResource ListBoxTemplate1}" x:Name="listBoxOut1"   Margin="0,0,0,10"
		                Grid.Column="2"
			                SelectionMode="Extended"     
                                                          MouseDoubleClick="ListBoxMouseDoubleClick"
		                >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FontFamily" Value="BIZ UDPゴシック" />
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    
                    <StackPanel Height="Auto" Width="Auto" Grid.Row="0" Grid.Column="1">
		                <Button Name="toRight1"
				            Click="OnBtnClick"
				            Content="→   "  Height="26" Width="50" Margin="10" />
	                    <Button  Name="toLeft1"
				            Click="OnBtnClick"
				            Content="←   "  Height="26" Width="50" Margin="10"  />
			        </StackPanel>
                    <StackPanel Name="PanelUpDown" Height="Auto" Width="Auto" Grid.Row="0" Grid.Column="3">
	                    <Button Name="toUp1"
				            Click="OnBtnClick"
				            Content="△   "   Height="26" Width="50"  Margin="10" />
	                    <Button  Name="toDown1"
				            Click="OnBtnClick"
				            Content="▽   "   Height="26" Width="50"  Margin="10" />
                    </StackPanel>

	            </Grid>

		        <StackPanel  Height="Auto" Width="Auto"  Orientation="Horizontal" >
                        <TextBlock Text="テキスト入力"  HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Background="Transparent"
	                     />
	                    <TextBox Name="TextBoxSer1" Width="1000" Height="26" 
		                     HorizontalAlignment="Left"  TextWrapping="Wrap" 
		                     Text="" 
                                 Margin="10,2,0,2" 
	                     />
                    <Button Name="BtnTextBoxSer1"  FontWeight="Bold"
				            Click="OnBtnClick"
				            Width="80" Content="入力"  HorizontalAlignment="Right" Margin="10,2,0,2" Height="26"/>
		        </StackPanel>
	        </StackPanel>

	        <StackPanel Name="StackPanel2"  Height="Auto" Width="Auto"  Margin="0,0,0,0" Background="White">

                <TextBlock  Name="TextBlock2" Text="添加物"  HorizontalAlignment="Center" VerticalAlignment="Center"
                           Background="Transparent" Margin="2"  FontWeight="Bold"
                 />

	            <Grid Name="Grid2"  Height="240" >
	                <Grid.ColumnDefinitions>
	                    <ColumnDefinition Width="570" />
	                    <ColumnDefinition Width="70" />
	                    <ColumnDefinition Width="570" />
	                    <ColumnDefinition Width="70" />
	                </Grid.ColumnDefinitions>

                    <ListBox x:Name="listBoxIn2"   Margin="0,0,0,10"
		                Grid.Column="0"
			                SelectionMode="Extended"
                            MouseDoubleClick="ListBoxMouseDoubleClick"
		            		                >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FontFamily" Value="BIZ UDPゴシック" />
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="listBoxOut2"   Margin="0,0,0,10"
		                Grid.Column="2"
			                SelectionMode="Extended"
                            MouseDoubleClick="ListBoxMouseDoubleClick"
		            		                >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FontFamily" Value="BIZ UDPゴシック" />
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Height="Auto" Width="Auto" Grid.Row="0" Grid.Column="1">
		                <Button Name="toRight2"
				            Click="OnBtnClick"
				            Content="→   "  Height="26" Width="50" Margin="10" />
	                    <Button  Name="toLeft2"
				            Click="OnBtnClick"
				            Content="←   "  Height="26" Width="50" Margin="10"  />
			        </StackPanel>
			        <StackPanel Height="Auto" Width="Auto" Grid.Row="0" Grid.Column="3">
	                    <Button Name="toUp2"
				            Click="OnBtnClick"
				            Content="△   "   Height="26" Width="50"  Margin="10" />
	                    <Button  Name="toDown2"
				            Click="OnBtnClick"
				            Content="▽   "   Height="26" Width="50"  Margin="10" />
			        </StackPanel>

	            </Grid>

		        <StackPanel  Height="Auto" Width="Auto"  Orientation="Horizontal" >
                        <TextBlock Text="テキスト入力"  HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Background="Transparent"
	                     />
	                    <TextBox Name="TextBoxSer2" Width="1000" Height="26" 
		                     HorizontalAlignment="Left"  TextWrapping="Wrap" 
		                     Text="" 
                                 Margin="10,2,0,2" 
	                     />
	                    <Button Name="BtnTextBoxSer2" 
				            Click="OnBtnClick" FontWeight="Bold"
				            Width="80" Content="入力"  HorizontalAlignment="Right" Margin="10,2,0,2" Height="26"/>
		        </StackPanel>
	        </StackPanel>


        </StackPanel>
    </Grid>
</Window>
