<Window x:Class=" Propla.TxtMsgBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Propla"
        mc:Ignorable="d"
        Title="TxtMsgBox" Height="500" Width="1000">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border  >

            <TextBox Name="TextBox" Height="310" 
                 Margin="20,20,20,20" TextWrapping="Wrap" 
                 Text="TextBox"  Width="900"
                 VerticalScrollBarVisibility="Auto" 
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 />

            </Border  >
        <Button Name="end" Grid.Row="1"
	                Click="OnBtnClick"
	                Width="80" Content="戻る"  Height="26"
                        Margin="0,0,0,0" />


    </Grid>
</Window>
