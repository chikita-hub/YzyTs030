<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Propla"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Class="Propla.StdWebBrowserEdit"
        mc:Ignorable="d"
            Height="700" Width="1330"  Top="0" Left="0"
        Title="HtmlEdit" 
     WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid  x:Name="MainGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="280" />
            <RowDefinition Height="30" />
            <RowDefinition Height="280" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid  Grid.Row="0">

            <StackPanel Orientation="Horizontal"    Height="Auto"  Margin="0,0,0,0">

                <Button x:Name="register" 
	                Click="OnBtnClick"
	                Width="80" Content="登録"    Height="26"
                        Margin="100,0,0,0" />
                <Button x:Name="cancel" 
	                Click="OnBtnClick"
	                Width="80" Content="戻る"  Height="26"
                        Margin="100,0,0,0" />
                <Button x:Name="template1" 
	                Click="OnBtnClick"
	                Width="100" Content="リンク雛形"      Height="26"
                        Margin="300,0,0,0" />
                <Button x:Name="template3" 
	                Click="OnBtnClick"
	                Width="100" Content="画像表示雛形"      Height="26"
                        Margin="50,0,0,0" />
                <Button x:Name="template2" 
	                Click="OnBtnClick"
	                Width="100" Content="文字雛形"      Height="26"
                        Margin="50,0,0,0" />
                <Button x:Name="sample" 
	                Click="OnBtnClick"
	                Width="100" Content="入力例"      Height="26"
                        Margin="50,0,0,0" />
            </StackPanel>

        </Grid>


        <Grid  Grid.Row="1">
            <Border  >
                <TextBox x:Name="EditTextBox"  
                     HorizontalAlignment="Left"  
                     TextWrapping="Wrap" 
                      Margin="20,20,0,20" Width="1250"
                      AcceptsReturn="True"
                        VerticalContentAlignment="Top"
                     />
            </Border>
        </Grid>

        <Grid  Grid.Row="2">
            <Button x:Name="BtnTextBoxDisp" 
	            Click="OnBtnClick"
	            Width="80" Content="確認"   Margin="100,0,0,0" Height="26"/>
        </Grid>


        <Grid  Grid.Row="3">
            <Border  >
                <Wpf:WebView2 Name="WebBrow" Width="NaN"  Source="http://example.com/"  />

            </Border>
        </Grid>

    </Grid>
</Window>
