<Window x:Class="Propla.ProPlaOutItemSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Propla"
        mc:Ignorable="d"
        Title="更新履歴" 
        Height="700" Width="1330" Top="0" Left="0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- colclass でグループ化 -->
            <CollectionViewSource x:Key="ItemsView" Source="{Binding Items}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="colclass"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <!-- 色（必要なら調整してください） -->
            <SolidColorBrush x:Key="HeaderBg" Color="#0F7AC6"/>
            <!-- 濃い青（大見出し） -->
            <SolidColorBrush x:Key="SubHeaderBg" Color="#5FAEE3"/>
            <!-- 中青（ヘッダ行） -->
            <SolidColorBrush x:Key="GroupCellBg" Color="#CFE6FF"/>
            <!-- 水色（大項目セル） -->
            <SolidColorBrush x:Key="TableBorder" Color="#0066CC"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="MainGrid" Height="700" Width="1330" Background="#ffffff">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <!-- 自作サブヘッダ -->
            <RowDefinition Height="50"/>
            <!-- 自作サブヘッダ -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" >
            <StackPanel Name="RowPanel1" Orientation="Horizontal" >
                <Button Content="戻る"     Name="BtnEnd" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,0,0,0"   Click="OnBtnClick"/>
                <TextBlock Text = "※選択した順に項目が並んで出力されます。"
                           Foreground="Black"  FontSize="16" Width="600"
                           Background="Transparent"
                           Margin="300,0,0,0"
                />
                <Button Content="－"     Name="BtnWindowStateMinimized" HorizontalAlignment="Left" Height="20" Width="20"  
                        Margin="150,0,0,0"   Click="OnBtnClick"/>
                
            </StackPanel>
            <StackPanel Name="RowPanelOut" Orientation="Horizontal" >
                <Button Content="全選択" Name="BtnAllSel" HorizontalAlignment="Left" Height="30" Width="80"  Margin="100,10,0,0"   Click="OnBtnClick"/>
                <Button Content="全解除" Name="BtnAllLift" HorizontalAlignment="Left" Height="30" Width="80"  Margin="50,10,0,0"   Click="OnBtnClick"/>
                <TextBlock Text = "※大項目をクリックで該当の小項目をすべて選択できます。"
                           Foreground="Black"  FontSize="16" Width="600"
                           Background="Transparent"
                           Margin="190,0,0,0"
                />
            </StackPanel>
        </StackPanel>


        <!-- 2段目ヘッダ（大項目｜小項目） -->
        <Grid Grid.Row="1" Margin="25,2,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1080"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SubHeaderBg}" BorderBrush="{StaticResource TableBorder}" BorderThickness="1">
                <TextBlock Text="大項目" Background="Transparent" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" Padding="6"/>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SubHeaderBg}" BorderBrush="{StaticResource TableBorder}" BorderThickness="1,1,1,1">
                <TextBlock Text="小項目" Background="Transparent" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" Padding="6"/>
            </Border>
        </Grid>

            <!-- 本体グリッド（DataGrid本体のヘッダは消して、上の自作ヘッダを使う） -->
            <DataGrid Grid.Row="2"
              ItemsSource="{Binding Source={StaticResource ItemsView}}"
              Style="{DynamicResource DataGridStyle1}"
              HeadersVisibility="None"
              GridLinesVisibility="All"
              BorderBrush="{StaticResource TableBorder}"
              BorderThickness="1"
              IsReadOnly="True"
              AutoGenerateColumns="False" 
              Width="1280"
              Name="DataGridMain" 
              Margin="25,10,25,50"
              SelectionMode="Extended">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                    </Style>
                </DataGrid.RowStyle>

            
            <!-- グループ見出し＝左の“縦結合”風セル -->
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <!-- 2列: 左=大項目セル（縦に伸ばす） 右=グループ内の明細行 -->
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- グループ内の行（右） -->
                                            <!-- ItemsPresenter の高さを左セルにバインドして“縦結合風”にする -->
                                            <ItemsPresenter x:Name="GroupRows" Grid.Column="1"/>

                                            <!-- 左の“結合セル” -->
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource GroupCellBg}"
                                                    BorderBrush="{StaticResource TableBorder}"
                                                    BorderThickness="1,0,1,1"
                                                    Height="{Binding ElementName=GroupRows, Path=ActualHeight}"
                                                    MouseLeftButtonDown="GroupCellMouseLeftButtonDown"
                                                    MinHeight="32" Padding="6,8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Top"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <!-- 明細は“小項目”だけを1列で表示 -->
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding colname}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
