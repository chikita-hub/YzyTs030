<Window x:Class="Propla.UserMgr"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Propla"
        mc:Ignorable="d"
        Title="ユーザマスタ" 
        Height="700" Width="1330"  Top="0" Left="0"
        >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DictionaryProPla.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </Window.Resources>

    <Grid  x:Name="MainGrid"  Height="700" Width="1330" Background= "#ffffff">

        <StackPanel Name="MainPanel"  Background= "#ffffff"   VerticalAlignment="Top" Grid.RowSpan="2">

            <StackPanel Name="RowPanel1" Orientation="Horizontal" >
                <Button Content="戻る"     Name="BtnEnd" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
                <Button Content="－"     Name="BtnWindowStateMinimized" HorizontalAlignment="Left" Height="20" Width="20"  Margin="1050,5,0,5"   Click="OnBtnClick"/>
            </StackPanel>

            <StackPanel  Orientation="Horizontal"  >

                <DataGrid ItemsSource="{Binding Items, Mode=OneWay}"   
                    Style="{DynamicResource DataGridStyle1}"
                    IsReadOnly="True" 
                    VerticalAlignment="Top"
                    Height="400" Width="800"
                    Name="DataGridMain" Margin="10,10,10,10" Grid.RowSpan="3" 
                    MouseDoubleClick="DataGridMainMouseDoubleClick"
                           AutoGenerateColumns="False"
                    >
                    <DataGrid.Columns >
                        <DataGridTextColumn Header="ユーザID"         Binding="{Binding userid}"       Width="100"  x:Name="userid" />
                        <DataGridTextColumn Header="ユーザ名"         Binding="{Binding username}"     Width="170"  x:Name="username" />
                        <DataGridTextColumn Header="メールアドレス"   Binding="{Binding mailaddress}"  Width="300"  x:Name="mailaddress" />

                        <DataGridComboBoxColumn  Header="権限区分"  x:Name="CmbAccountauthority"
                                             SelectedValueBinding="{Binding accessauthorityid}" 
                                             DisplayMemberPath = "accessauthorityname"
                                             SelectedValuePath = "accessauthorityid"
                                             Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Name="RowPanel2" Orientation="Horizontal" >
                <Button Content="更新"   Name="BtnMod" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
                <Button Content="新規"   Name="BtnNew" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
            </StackPanel>

            <StackPanel Name="RowPanel3" Orientation="Horizontal"  Background="Aqua"  Margin="20,5,20,5">
                <Border  Width="90"  Margin="20,0,0,0"   Background="Aqua" >
                    <TextBlock Text="ユーザID"  Background="Aqua"  HorizontalAlignment="Left" VerticalAlignment="Center"  />
                </Border>
                <TextBox   Name="TxtUserId" HorizontalAlignment="Left" Height="30" Width="80"  Margin="0,5,0,5" GotFocus="TextBoxGotFocusAlphanumeric" />

                <Border  Width="90"  Margin="30,0,0,0"   Background="Aqua" >
                    <TextBlock Text="ユーザ名"    Background="Aqua"  HorizontalAlignment="Left" VerticalAlignment="Center"  />
                </Border>
                <TextBox   Name="TxtUserName" HorizontalAlignment="Left" Height="30" Width="150"  Margin="0,5,0,5"  />

                <Border  Width="120"  Margin="30,0,0,0"   Background="Aqua" >
                    <TextBlock Text="メールアドレス"  Background="Aqua"  HorizontalAlignment="Left" VerticalAlignment="Center"  />
                </Border>
                <TextBox   Name="TxtMailAddr"     HorizontalAlignment="Left" Height="30" Width="250"  Margin="5,5,0,5"  />

                <Border  Width="90"  Margin="30,0,0,0"   Background="Aqua" >
                    <TextBlock Text="権限区分"     Background="Aqua"  HorizontalAlignment="Left" VerticalAlignment="Center"  />
                </Border>
                <ComboBox  Name="CmbAuth"   HorizontalAlignment="Left" Height="30"     Width="100"  Margin="0,0,0,5" 
                                            />
                <Button Content="パスワード"   Name="BtnPass" HorizontalAlignment="Left" Height="30" Width="100"  Margin="80,5,0,5"   Click="OnBtnClick"/>
            </StackPanel>

            <StackPanel  Orientation="Horizontal" >
                <Button Content="登録"   Name="BtnSet" HorizontalAlignment="Left" Height="30" Width="100"  Margin="100,5,0,5"   Click="OnBtnClick"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
