@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="propla-message propla-message-error">@ErrorMessage</div>
}
else if (IsLoading)
{
    <div class="propla-message propla-message-info">読み込み中...</div>
}
else if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="propla-message propla-message-success">@SuccessMessage</div>
}
