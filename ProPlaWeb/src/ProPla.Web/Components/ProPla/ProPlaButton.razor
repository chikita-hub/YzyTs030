@if (!string.IsNullOrWhiteSpace(Href))
{
    <a href="@Href" class="@BuildCssClass()" target="@Target" rel="@Rel">@Text</a>
}
else
{
    <button type="@Type" class="@BuildCssClass()" @onclick="OnClick" disabled="@Disabled">@Text</button>
}

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string Kind { get; set; } = "Normal";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Rel { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string AdditionalClass { get; set; } = string.Empty;

    private string BuildCssClass()
    {
        var css = Kind switch
        {
            "Primary" => "propla-button propla-button-primary",
            "Accent" => "propla-button propla-button-accent",
            _ => "propla-button"
        };

        return string.IsNullOrWhiteSpace(AdditionalClass) ? css : $"{css} {AdditionalClass}";
    }
}
