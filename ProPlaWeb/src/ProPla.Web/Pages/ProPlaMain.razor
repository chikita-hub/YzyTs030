@page "/propla/main/{ProductPlanningId}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ProPla.Web.Data
@using ProPla.Web.Services.ProPla
@inject IProPlaMasterService MasterService

<ProPlaLayout PageTitle="ProPla Main" Title="商品情報マスタ（詳細）">
    <TopLeft>
        <div class="propla-inline-buttons">
            <ProPlaButton Text="更新許可" Kind="Primary" OnClick="@AllowUpdate" />
            <ProPlaButton Text="更新" Kind="Accent" Disabled="@(CurrentItem is null)" OnClick="@EnableProductNameEdit" />
            <ProPlaButton Text="引用" Disabled="true" />
            <ProPlaButton Text="戻る" Kind="Primary" Href="/propla/search" />
        </div>
    </TopLeft>

    <MainContent>
        <ProPlaMessageArea IsLoading="@IsLoading" ErrorMessage="@ErrorMessage" SuccessMessage="@SuccessMessage" />

        @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage) && CurrentItem is null)
        {
            <div class="propla-message propla-message-info">
                商品ID: <strong>@ProductPlanningId</strong> のデータが見つかりません。
            </div>
        }
        else if (CurrentItem is not null)
        {
            <ProPlaSection Title="商品基本情報">
                <div class="propla-form-grid">
                    <div>
                        <label class="propla-label">商品ID</label>
                        <input class="propla-input" value="@CurrentItem.ProductPlanningId" readonly />
                    </div>
                    <div>
                        <label class="propla-label">商品区分</label>
                        <input class="propla-input" value="@CurrentItem.ProductCategory" readonly />
                    </div>
                    <div>
                        <label class="propla-label">商品担当者</label>
                        <input class="propla-input" value="@CurrentItem.ProductPerson" readonly />
                    </div>
                    <div class="propla-field-span-3">
                        <label class="propla-label">正式商品名</label>
                        <input class="propla-input" @bind="EditableProductName" readonly="@(!IsProductNameEditable)" />
                    </div>
                    <div>
                        <label class="propla-label">読み仮名</label>
                        <input class="propla-input" value="@CurrentItem.ProductNameRuby" readonly />
                    </div>
                    <div>
                        <label class="propla-label">正式商品名（英表記）</label>
                        <input class="propla-input" value="@CurrentItem.ProductNameOfficialE" readonly />
                    </div>
                    <div>
                        <label class="propla-label">略称</label>
                        <input class="propla-input" value="@CurrentItem.ProductNameOmit1" readonly />
                    </div>
                    <div>
                        <label class="propla-label">お買上票の商品名</label>
                        <input class="propla-input" value="@CurrentItem.ProductNameReceipt" readonly />
                    </div>
                    <div>
                        <label class="propla-label">発売の状態</label>
                        <input class="propla-input" value="@CurrentItem.ProductReleaseStatus" readonly />
                    </div>
                    <div>
                        <label class="propla-label">テスト発売日</label>
                        <input class="propla-input" value="@CurrentItem.ProductTestReleaseDate" readonly />
                    </div>
                    <div>
                        <label class="propla-label">本発売日</label>
                        <input class="propla-input" value="@CurrentItem.ProductReleaseDate" readonly />
                    </div>
                    <div>
                        <label class="propla-label">本発売日から</label>
                        <input class="propla-input" value="@CurrentItem.ProductAnniversary" readonly />
                    </div>
                    <div class="propla-field-span-2">
                        <label class="propla-label">リニューアル履歴</label>
                        <input class="propla-input" value="@CurrentItem.ProductRenewalHistory" readonly />
                    </div>
                    <div class="propla-field-span-3">
                        <label class="propla-label">商標取得一覧</label>
                        <textarea class="propla-textarea" rows="4" readonly>@CurrentItem.TrademarkAcquisitionList</textarea>
                    </div>
                </div>
            </ProPlaSection>
        }
    </MainContent>
</ProPlaLayout>

@code {
    [Parameter] public string ProductPlanningId { get; set; } = string.Empty;

    private bool IsLoading { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private bool IsProductNameEditable { get; set; }
    private string EditableProductName { get; set; } = string.Empty;
    private ProductPlanning? CurrentItem { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
        IsProductNameEditable = false;

        try
        {
            CurrentItem = await MasterService.GetByIdAsync(ProductPlanningId);
            EditableProductName = CurrentItem?.ProductNameOfficial ?? string.Empty;
            if (CurrentItem is not null)
            {
                SuccessMessage = $"商品ID: {CurrentItem.ProductPlanningId}";
            }
        }
        catch (Exception ex)
        {
            CurrentItem = null;
            EditableProductName = string.Empty;
            ErrorMessage = $"商品情報の取得でエラーが発生しました: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task AllowUpdate()
    {
        SuccessMessage = "更新許可を有効にする処理をここへ実装します。";
        return Task.CompletedTask;
    }

    private Task EnableProductNameEdit()
    {
        IsProductNameEditable = CurrentItem is not null;
        SuccessMessage = IsProductNameEditable ? "正式商品名を編集できます。" : string.Empty;
        return Task.CompletedTask;
    }
}
