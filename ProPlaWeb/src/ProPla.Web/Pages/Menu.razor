@page "/propla/menu"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>ProPla Menu</PageTitle>

<h1>商品情報マスタ</h1>

<div class="row g-3 mt-1">
    @foreach (var item in MenuItems)
    {
        <div class="col-12 col-md-6">
            @if (!item.IsEnabled)
            {
                <button class="btn btn-secondary w-100 py-3" disabled>@item.Label</button>
            }
            else if (item.IsExternal)
            {
                <a class="btn btn-primary w-100 py-3" href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Label</a>
            }
            else
            {
                <a class="btn btn-primary w-100 py-3" href="@item.Url">@item.Label</a>
            }
        </div>
    }
</div>

