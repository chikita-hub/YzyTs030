@page "/propla/menu"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ProPla.Web.Models.ProPla

<ProPlaLayout PageTitle="ProPla Menu" Title="商品情報マスタ">
    <TopRight>
        <ProPlaButton Text="－" Kind="Primary" AdditionalClass="propla-window-button" />
    </TopRight>

    <MainContent>
        <div class="propla-grid-2">
            @foreach (var item in MenuItems)
            {
                <div>
                    @if (!item.IsEnabled)
                    {
                        <button class="propla-button" disabled>@item.Label</button>
                    }
                    else
                    {
                        <ProPlaButton Text="@item.Label"
                                      Kind="@item.ButtonKind"
                                      Href="@item.Url"
                                      Target="@(item.IsExternal ? "_blank" : null)"
                                      Rel="@(item.IsExternal ? "noopener noreferrer" : null)" />
                    }
                </div>
            }
        </div>
    </MainContent>
</ProPlaLayout>

@code {
    private static readonly IReadOnlyList<ProPlaMenuItem> MenuItems = new List<ProPlaMenuItem>
    {
        new() { Label = "商品検索・データ出力", Url = "/propla/search", ButtonKind = "Normal" },
        new() { Label = "法律関係リンク", Url = "https://yazuyaoffice.sharepoint.com/", IsExternal = true },
        new() { Label = "使い方ガイド", Url = "https://yazuyaoffice.sharepoint.com/", IsExternal = true },
        new() { Label = "各種リンク先一覧", Url = "https://yazuyaoffice.sharepoint.com/", IsExternal = true },
        new() { Label = "パスワード変更", Url = "/Account/Login", ButtonKind = "Accent" },
        new() { Label = "【キセキ専用】各種リンク先一覧", Url = "https://yazuyaoffice.sharepoint.com/", IsExternal = true },
        new() { Label = "表示履歴", Url = "/fetchdata", ButtonKind = "Accent" },
        new() { Label = "【商品企画室専用】各種リンク先一覧", Url = "https://yazuyaoffice.sharepoint.com/", IsExternal = true },
        new() { Label = "ユーザマスタ", Url = "/", IsEnabled = false },
        new() { Label = "区分マスタ", Url = "/", IsEnabled = false },
        new() { Label = "（未使用）", Url = string.Empty, IsEnabled = false },
        new() { Label = "ログアウト", Url = "/Account/Login", ButtonKind = "Accent" }
    };
}
