@page "/propla/menu"

<ProPlaLayout PageTitle="商品情報マスタ" Title="商品情報マスタ">
    <TopRight>
        <button type="button" class="propla-button propla-window-button" aria-label="最小化">－</button>
    </TopRight>

    <MainContent>
        <div class="propla-grid-2">
            <a class="propla-button propla-menu-button" href="/propla/search">
                商品検索・データ出力
            </a>

            <a class="propla-button propla-menu-button" href="/propla/main/link-law">
                法律関係リンク
            </a>

            <a class="propla-button propla-menu-button" href="/propla/main/guide">
                使い方ガイド
            </a>

            <a class="propla-button propla-menu-button" href="/propla/main/link-list">
                各種リンク先一覧
            </a>

            <a class="propla-button propla-button-accent propla-menu-button" href="/propla/main/password">
                パスワード変更
            </a>

            <div></div>

            <a class="propla-button propla-button-accent propla-menu-button" href="/propla/main/history">
                表示履歴
            </a>

            <a class="propla-button propla-button-accent propla-menu-button" href="/propla/main/planning-links">
                [商品企画室専用]各種リンク先一覧
            </a>

            <a class="propla-button propla-button-accent propla-menu-button" href="/propla/main/user-master">
                ユーザマスタ
            </a>

            <a class="propla-button propla-button-accent propla-menu-button" href="/propla/main/category-master">
                区分マスタ
            </a>

            <div></div>

            <form method="post" action="/Account/Logout">
                <button type="submit" class="propla-button propla-menu-button">
                    ログアウト
                </button>
            </form>
        </div>
    </MainContent>
</ProPlaLayout>
