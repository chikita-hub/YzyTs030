 @page "/propla/search"
@attribute [Authorize]
 @using Microsoft.AspNetCore.Authorization
 @using Microsoft.EntityFrameworkCore
 @using ProPla.Web.Data
 @inject NavigationManager Nav
 @inject AppDbContext DbContext

<PageTitle>ProPla Search</PageTitle>

<h1>商品検索・データ出力</h1>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary">新規登録</button>
    <a class="btn btn-secondary" href="/propla/menu">戻る</a>
</div>

<div class="card mb-3">
    <div class="card-body d-flex gap-2 align-items-center flex-wrap">
        <label for="keyword" class="form-label mb-0">キーワード</label>
        <input id="keyword" class="form-control" style="max-width: 320px;" @bind="keyword" />
        <button class="btn btn-primary" @onclick="Search" disabled="@IsLoading">検索</button>
    </div>
</div>

 @if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

@if (IsLoading)
{
    <div class="alert alert-info" role="alert">読み込み中...</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>選択</th>
                <th>商品ID</th>
                <th>商品区分</th>
                <th>商品担当者</th>
                <th>正式商品名</th>
                <th>発売の状態</th>
            </tr>
        </thead>
        <tbody>
            @if (FilteredItems.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">データがありません。</td>
                </tr>
            }
            else
            {
                @foreach (var item in FilteredItems)
                {
                    <tr>
                        <td>
                            <button class="btn btn-sm btn-primary" @onclick="(() => SelectItem(item.ProductPlanningId))">選択</button>
                        </td>
                        <td>@item.ProductPlanningId</td>
                        <td>@item.ProductCategory</td>
                        <td>@item.ProductPerson</td>
                        <td>@item.ProductNameOfficial</td>
                        <td>@item.ProductReleaseStatus</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private string keyword = string.Empty;

    private bool IsLoading { get; set; }

    private string ErrorMessage { get; set; } = string.Empty;

    private List<ProductPlanning> AllItems { get; set; } = new();

    private List<ProductPlanning> FilteredItems { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            AllItems = await DbContext.ProductPlannings
                .AsNoTracking()
                .OrderBy(x => x.ProductPlanningId)
                .ToListAsync();

            FilteredItems = AllItems;
        }
        catch (Exception ex)
        {
            AllItems = new List<ProductPlanning>();
            FilteredItems = new List<ProductPlanning>();
            ErrorMessage = $"商品一覧の取得でエラーが発生しました: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            FilteredItems = AllItems;
            return;
        }

        FilteredItems = AllItems
            .Where(x => (x.ProductPlanningId ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                        || (x.ProductCategory ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                        || (x.ProductPerson ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                        || (x.ProductNameOfficial ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                        || (x.ProductReleaseStatus ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void SelectItem(string id)
    {
        Nav.NavigateTo($"/propla/main/{id}");
    }
 }
