@page "/propla/search"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ProPla.Web.Models.ProPla
@using ProPla.Web.Services.ProPla
@inject IProPlaSearchService SearchService
@inject NavigationManager Nav

<ProPlaLayout PageTitle="ProPla Search" Title="商品検索・データ出力">
    <TopLeft>
        <div class="propla-inline-buttons">
            <ProPlaButton Text="新規登録" Kind="Primary" />
            <ProPlaButton Text="戻る" Kind="Primary" Href="/propla/menu" />
        </div>
    </TopLeft>

    <TopRight>
        <ProPlaButton Text="－" Kind="Primary" AdditionalClass="propla-window-button" />
    </TopRight>

    <Toolbar>
        <ProPlaToolbar SelectedOutputType="@SelectedOutputType"
                       SelectedOutputTypeChanged="@OnSelectedOutputTypeChanged"
                       OnExport="@ExportAsync" />
    </Toolbar>

    <MainContent>
        <ProPlaSearchPanel Keyword="@Condition.Keyword"
                           KeywordChanged="@OnKeywordChanged"
                           SelectedStatus="@Condition.Status"
                           SelectedStatusChanged="@OnStatusChanged"
                           StatusOptions="@StatusOptions"
                           Disabled="@IsLoading"
                           OnSearch="@SearchAsync" />

        <ProPlaMessageArea IsLoading="@IsLoading" ErrorMessage="@ErrorMessage" SuccessMessage="@SuccessMessage" />

        <ProPlaDataTable Items="@Items" OnSelect="@SelectItem" />
    </MainContent>
</ProPlaLayout>

@code {
    private ProPlaSearchCondition Condition { get; set; } = new();
    private List<string> StatusOptions { get; set; } = new();
    private List<ProPlaSearchResultRow> Items { get; set; } = new();
    private bool IsLoading { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private string SelectedOutputType { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        try
        {
            StatusOptions = await SearchService.GetStatusOptionsAsync();
            if (!StatusOptions.Contains(Condition.Status))
            {
                Condition.Status = string.Empty;
            }
            Items = await SearchService.SearchAsync(Condition);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"商品一覧の取得でエラーが発生しました: {ex.Message}";
            Items = new();
            StatusOptions = new();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        try
        {
            Items = await SearchService.SearchAsync(Condition);
            SuccessMessage = $"{Items.Count} 件取得しました。";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"検索でエラーが発生しました: {ex.Message}";
            Items = new();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task OnKeywordChanged(string value)
    {
        Condition.Keyword = value;
        return Task.CompletedTask;
    }

    private Task OnStatusChanged(string value)
    {
        Condition.Status = value;
        return Task.CompletedTask;
    }

    private Task OnSelectedOutputTypeChanged(string value)
    {
        SelectedOutputType = value;
        return Task.CompletedTask;
    }

    private Task ExportAsync()
    {
        SuccessMessage = string.IsNullOrWhiteSpace(SelectedOutputType)
            ? "出力種別を選択してください。"
            : $"{SelectedOutputType} 出力はこれから実装できます。";
        return Task.CompletedTask;
    }

    private void SelectItem(string productCode)
    {
        Nav.NavigateTo($"/propla/main/{productCode}");
    }
}
