@page "/propla/search"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ProPla.Web.Data
@inject NavigationManager Nav
@inject AppDbContext DbContext

<PageTitle>ProPla Search</PageTitle>

<div class="propla-page">
    <div class="propla-header">
        <div class="propla-header-left">
            <button type="button" class="propla-button" @onclick="CreateNew">新規登録</button>
            <a class="propla-button" href="/propla/menu">戻る</a>
        </div>
        <div class="propla-header-center">
            <h1 class="propla-title">商品検索・データ出力</h1>
        </div>
        <div class="propla-header-right">
            <button type="button" class="propla-button-primary propla-window-button" aria-label="最小化">－</button>
        </div>
    </div>

    <div class="propla-panel" style="margin-bottom:16px;">
        <div class="propla-search-toolbar">
            <button type="button" class="propla-button">全選択</button>
            <button type="button" class="propla-button">全解除</button>

            <label for="outputType" style="margin-left:18px;">出力種別</label>
            <select id="outputType" class="propla-select" style="min-width:250px;">
                <option value=""></option>
            </select>

            <button type="button" class="propla-button">項目選択</button>
            <button type="button" class="propla-button">選択保存</button>
            <button type="button" class="propla-button">選択読込</button>
            <button type="button" class="propla-button-accent">出力</button>
        </div>
    </div>

    <div class="propla-panel" style="margin-bottom:16px;">
        <div class="propla-search-row">
            <label for="keyword">キーワード</label>
            <input id="keyword" class="propla-input" style="width:250px;" @bind="keyword" />

            <label for="status" style="margin-left:18px;">状態</label>
            <select id="status" class="propla-select" style="width:220px;" @bind="selectedStatus">
                <option value="">すべて</option>
                @foreach (var status in StatusOptions)
                {
                    <option value="@status">@status</option>
                }
            </select>

            <button type="button" class="propla-button-primary" @onclick="Search" disabled="@IsLoading">検索</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="propla-panel propla-message-area" style="margin-bottom:16px;">@ErrorMessage</div>
    }

    @if (IsLoading)
    {
        <div class="propla-panel propla-message-area">読み込み中...</div>
    }
    else
    {
        <div class="propla-panel propla-table-panel">
            <table class="propla-table">
                <thead>
                    <tr>
                        <th>選択</th>
                        <th>商品ID</th>
                        <th>商品区分</th>
                        <th>商品担当者</th>
                        <th>正式商品名</th>
                        <th>状態</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredItems.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="propla-table-empty">データがありません。</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredItems)
                        {
                            <tr>
                                <td>
                                    <button type="button" class="propla-button-primary propla-button-small" @onclick="(() => SelectItem(item.ProductPlanningId))">選択</button>
                                </td>
                                <td>@item.ProductPlanningId</td>
                                <td>@item.ProductCategory</td>
                                <td>@item.ProductPerson</td>
                                <td>@item.ProductNameOfficial</td>
                                <td>@item.ProductReleaseStatus</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string keyword = string.Empty;
    private string selectedStatus = string.Empty;
    private bool IsLoading { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private List<ProductPlanning> AllItems { get; set; } = new();
    private List<ProductPlanning> FilteredItems { get; set; } = new();
    private List<string> StatusOptions { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            AllItems = await DbContext.ProductPlannings
                .AsNoTracking()
                .OrderBy(x => x.ProductPlanningId)
                .ToListAsync();

            StatusOptions = AllItems
                .Select(x => x.ProductReleaseStatus)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x)
                .Cast<string>()
                .ToList();

            selectedStatus = StatusOptions.Contains("本発売中") ? "本発売中" : string.Empty;
            Search();
        }
        catch (Exception ex)
        {
            AllItems = new List<ProductPlanning>();
            FilteredItems = new List<ProductPlanning>();
            StatusOptions = new List<string>();
            ErrorMessage = $"商品一覧の取得でエラーが発生しました: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void Search()
    {
        IEnumerable<ProductPlanning> query = AllItems;

        if (!string.IsNullOrWhiteSpace(selectedStatus))
        {
            query = query.Where(x => string.Equals(x.ProductReleaseStatus, selectedStatus, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            query = query.Where(x => (x.ProductPlanningId ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductCategory ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductPerson ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductNameOfficial ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductReleaseStatus ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        FilteredItems = query.ToList();
    }

    private void SelectItem(string id)
    {
        Nav.NavigateTo($"/propla/main/{id}");
    }

    private void CreateNew()
    {
        Nav.NavigateTo("/propla/main");
    }
}
