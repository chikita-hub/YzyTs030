@page "/propla/search"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>ProPla Search</PageTitle>

<h1>商品検索・データ出力</h1>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary">新規登録</button>
    <a class="btn btn-secondary" href="/propla/menu">戻る</a>
</div>

<div class="card mb-3">
    <div class="card-body d-flex gap-2 align-items-center flex-wrap">
        <label for="keyword" class="form-label mb-0">キーワード</label>
        <input id="keyword" class="form-control" style="max-width: 320px;" @bind="keyword" />
        <button class="btn btn-primary" @onclick="Search">検索</button>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>企画ID</th>
            <th>商品名</th>
            <th>状態</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in filteredItems)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string keyword = string.Empty;

    private readonly List<ProductRow> allItems = new()
    {
        new("PP-0001", "青汁プレミアム", "有効"),
        new("PP-0002", "コラーゲンドリンク", "有効"),
        new("PP-0003", "マルチビタミン", "停止")
    };

    private List<ProductRow> filteredItems = new();

    protected override void OnInitialized()
    {
        filteredItems = allItems;
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            filteredItems = allItems;
            return;
        }

        filteredItems = allItems
            .Where(x => x.Id.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                        || x.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                        || x.Status.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private sealed record ProductRow(string Id, string Name, string Status);
}
