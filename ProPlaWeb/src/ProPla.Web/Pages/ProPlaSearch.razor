@page "/propla/search"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ProPla.Web.Data
@inject NavigationManager Nav
@inject AppDbContext DbContext

<PageTitle>ProPla Search</PageTitle>

<div class="propla-search-page">
    <div class="top-button-row">
        <button class="action-button small" type="button">新規登録</button>
        <a class="action-button small back-button" href="/propla/menu">戻る</a>
        <button class="window-button" type="button" aria-label="最小化">─</button>
    </div>

    <div class="panel export-panel">
        <div class="export-note">※選択した項目を保存する場合は「選択保存」を押し、次回は選択読込を押してご利用ください。</div>

        <div class="export-row">
            <button class="action-button" type="button">全選択</button>
            <button class="action-button" type="button">全解除</button>

            <label class="field-label" for="outputType">出力種別</label>
            <select id="outputType" class="input-box wide-select" @bind="selectedOutputType">
                <option value=""></option>
                <option value="csv">CSV</option>
                <option value="excel">Excel</option>
                <option value="pdf">PDF</option>
            </select>

            <button class="action-button" type="button">項目選択</button>
            <button class="action-button" type="button">選択保存</button>
            <button class="action-button" type="button">選択読込</button>
            <button class="execute-button" type="button">出力</button>
        </div>
    </div>

    <div class="panel search-panel">
        <div class="search-row">
            <label class="field-label" for="keyword">キーワード</label>
            <input id="keyword" class="input-box keyword-box" @bind="keyword" />

            <label class="field-label status-label" for="status">状態</label>
            <select id="status" class="input-box status-box" @bind="selectedStatus">
                <option value="">すべて</option>
                @foreach (var status in StatusOptions)
                {
                    <option value="@status">@status</option>
                }
            </select>

            <button class="search-button" @onclick="Search" disabled="@IsLoading">検索</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@ErrorMessage</div>
    }

    @if (IsLoading)
    {
        <div class="alert alert-info mt-3" role="alert">読み込み中...</div>
    }
    else
    {
        <div class="result-panel mt-3">
            <table class="table table-bordered table-hover mb-0 result-table">
                <thead>
                    <tr>
                        <th>選択</th>
                        <th>商品ID</th>
                        <th>商品区分</th>
                        <th>商品担当者</th>
                        <th>正式商品名</th>
                        <th>状態</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredItems.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center">データがありません。</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredItems)
                        {
                            <tr>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="(() => SelectItem(item.ProductPlanningId))">選択</button>
                                </td>
                                <td>@item.ProductPlanningId</td>
                                <td>@item.ProductCategory</td>
                                <td>@item.ProductPerson</td>
                                <td>@item.ProductNameOfficial</td>
                                <td>@item.ProductReleaseStatus</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>


@code {
    private string keyword = string.Empty;
    private string selectedStatus = "本発売中";
    private string selectedOutputType = string.Empty;

    private bool IsLoading { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private List<ProductPlanning> AllItems { get; set; } = new();
    private List<ProductPlanning> FilteredItems { get; set; } = new();
    private List<string> StatusOptions { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            AllItems = await DbContext.ProductPlannings
                .AsNoTracking()
                .OrderBy(x => x.ProductPlanningId)
                .ToListAsync();

            StatusOptions = AllItems
                .Select(x => x.ProductReleaseStatus)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x)
                .Cast<string>()
                .ToList();

            if (!StatusOptions.Contains(selectedStatus))
            {
                selectedStatus = string.Empty;
            }

            Search();
        }
        catch (Exception ex)
        {
            AllItems = new List<ProductPlanning>();
            FilteredItems = new List<ProductPlanning>();
            StatusOptions = new List<string>();
            ErrorMessage = $"商品一覧の取得でエラーが発生しました: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void Search()
    {
        IEnumerable<ProductPlanning> query = AllItems;

        if (!string.IsNullOrWhiteSpace(selectedStatus))
        {
            query = query.Where(x => string.Equals(x.ProductReleaseStatus, selectedStatus, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            query = query.Where(x => (x.ProductPlanningId ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductCategory ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductPerson ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductNameOfficial ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase)
                                     || (x.ProductReleaseStatus ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        FilteredItems = query.ToList();
    }

    private void SelectItem(string id)
    {
        Nav.NavigateTo($"/propla/main/{id}");
    }
}
