@page
@model ProPla.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "ログイン";
}

<h3>ログイン</h3>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.UserId" class="form-label">ユーザーID</label>
        <input asp-for="Input.UserId" class="form-control" />
        <span asp-validation-for="Input.UserId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">パスワード</label>
        <input asp-for="Input.Password" type="password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">ログイン状態を保持</label>
    </div>

    <button type="submit" class="btn btn-primary">ログイン</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
}